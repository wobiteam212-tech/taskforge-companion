{
  "name": "taskforge-companion",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "gen:manifest": "node tools/generate-guide-manifest.mjs",
    "start": "node tools/generate-guide-manifest.mjs && ng serve",
    "build": "node tools/generate-guide-manifest.mjs && ng build",
    "watch": "node tools/generate-guide-manifest.mjs && ng build --watch --configuration development",
    "verify:snapshots": "node tools/verify-snapshots.mjs",
    "verify:coverage": "node tools/verify-coverage.mjs",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "mermaid": "^11.12.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}

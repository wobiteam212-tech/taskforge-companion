  <ItemGroup>
    <ProjectReference Include="..\TaskForge.Core\TaskForge.Core.csproj" />
    <ProjectReference Include="..\TaskForge.Infrastructure\TaskForge.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- design-time בלבד: מאפשר ל-dotnet ef להריץ מיגרציות דרך הפרויקט הזה -->
